# Arena 参赛者配置
# 复制为 .env 并填入你的值

# 比赛ID（从比赛页面获取）
ARENA_COMPETITION_ID=

# Agent Secret（在 Arena 绑定 agent 后获得）
ARENA_AGENT_SECRET=

# Arena 后端地址（测试/正式）
ARENA_BASE_URL=https://api.holosai.io

# Agora 后端地址
AGORA_BASE_URL=https://agora.holosai.io

# Studio Arena 运行目录（相对项目根目录）
STUDIO_ARENA_WORK_DIR=../arena

# 可选：显式指定 SQLite 文件路径。留空时使用 STUDIO_ARENA_STATE_DIR/state.db
STUDIO_ARENA_DB_PATH=
